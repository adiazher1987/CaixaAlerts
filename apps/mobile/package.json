{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_ROUTER_APP_ROOT=app expo start",
    "android": "EXPO_ROUTER_APP_ROOT=app expo run:android --device",
    "ios": "EXPO_ROUTER_APP_ROOT=app expo run:ios",
    "web": "EXPO_ROUTER_APP_ROOT=app expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:web": "expo export --platform web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@caixalertas/api-client": "*",
    "@caixalertas/i18n": "*",
    "@caixalertas/types": "*",
    "@hookform/resolvers": "^3.9.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@react-navigation/native": "^7.0.0",
    "@tanstack/react-query": "^5.60.0",
    "@types/react": "~19.0.10",
    "date-fns": "^3.6.0",
    "expo": "~53.0.0",
    "expo-build-properties": "~0.14.8",
    "expo-constants": "~17.1.8",
    "expo-device": "~7.1.4",
    "expo-font": "~13.3.2",
    "expo-linking": "~7.1.7",
    "expo-local-authentication": "~16.0.5",
    "expo-localization": "~16.1.6",
    "expo-notifications": "~0.31.5",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-updates": "~0.28.18",
    "i18next": "^23.11.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "^0.20.0",
    "typescript": "~5.8.3",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.0",
    "typescript": "^5.5.0"
  }
}
