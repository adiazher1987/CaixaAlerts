APP_ENV=production
NODE_ENV=production
BACKEND_PORT=3000
BACKEND_API_PREFIX=/api/v1
# En producción, todas las variables sensibles deben venir de un gestor de secretos
# (AWS Secrets Manager, Azure Key Vault, Doppler, etc.) — NO guardar valores aquí
MONGODB_URI=
MONGODB_DB_NAME=caixalertas_prod
REDIS_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=https://caixalertas.internal
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=warn
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
