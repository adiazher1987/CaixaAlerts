APP_ENV=staging
NODE_ENV=production
BACKEND_PORT=3000
BACKEND_API_PREFIX=/api/v1
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/caixalertas_staging
MONGODB_DB_NAME=caixalertas_staging
REDIS_URL=redis://redis-staging:6379
JWT_ACCESS_SECRET=CHANGE_ME_STAGING_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_STAGING_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=https://staging.caixalertas.internal
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
LOG_LEVEL=info
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=
