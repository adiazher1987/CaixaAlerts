# ─────────────────────────────────────────────
# CaixAlertas — Variables de entorno (ejemplo)
# Copia este fichero como .env.development / .env.staging / .env.production
# y rellena los valores reales. NUNCA subas ficheros .env con secretos al repo.
# ─────────────────────────────────────────────

# Entorno: development | staging | production
APP_ENV=development
NODE_ENV=development

# ── Backend ───────────────────────────────────
BACKEND_PORT=3000
BACKEND_API_PREFIX=/api/v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/caixalertas_dev
MONGODB_DB_NAME=caixalertas_dev

# Redis (sesiones, cache, rate limiting)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:8081,http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Firebase Admin (backend) ──────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# ── Email transaccional ───────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=change_me
EMAIL_FROM="CaixAlertas <alerts@example.com>"

# ── Logging ───────────────────────────────────
LOG_LEVEL=debug

# ── Mobile (Expo) ─────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id
